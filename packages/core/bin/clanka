#!/usr/bin/env node
const fs = require('node:fs');
const path = require('node:path');

const verifyJs = path.join(__dirname, '../dist/verify.js');

/**
 * EventLog helper — not the published `clanka-core` bin.
 * `packages/core` has no package.json / tsc build, so dist/verify.js is not
 * produced by `npm run build`. Refuse rather than crashing on a missing module
 * or advertising a working `clanka verify` command.
 */
if (!fs.existsSync(verifyJs)) {
  console.error(
    'packages/core/bin/clanka is an unbuilt EventLog helper (no packages/core/dist/verify.js).\n' +
      'This is not the published `clanka-core` CLI.\n' +
      'Use `clanka-core verify <runId>` for kernel integrity, or import verifyRun from packages/core/verify.ts.',
  );
  process.exit(2);
}

const { verifyRun } = require(verifyJs);

async function main() {
  const args = process.argv.slice(2);
  const subcommand = args[0];

  if (subcommand !== 'verify') {
    console.error('Usage: clanka verify --run <path> [--strict]');
    console.error('This helper is not `clanka-core`. Prefer `clanka-core verify <runId>`.');
    process.exit(2);
  }

  const runIndex = args.indexOf('--run');
  if (runIndex === -1 || !args[runIndex + 1]) {
    console.error('Error: --run <path> is required');
    process.exit(2);
  }

  const runPath = args[runIndex + 1];
  const strict = args.includes('--strict');

  try {
    const result = await verifyRun(runPath, { strict });
    if (result.eventCount === 0) {
      console.error(`FAIL ${runPath} No events`);
      process.exit(1);
    }
    console.log(`Verified ${result.eventCount} events in ${runPath}`);
  } catch (e) {
    console.error(`Verification failed: ${e.message}`);
    process.exit(1);
  }
}

main().catch(e => {
  console.error(e);
  process.exit(1);
});
